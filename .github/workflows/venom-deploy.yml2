name: VENOM Motherland Deploy

on:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:

  validate:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip

          if [ -f requirements.txt ]; then
            pip install -r requirements.txt
          fi

      - name: Validate Backend Syntax
        run: |
          python -m py_compile backend/venom_core.py

      - name: Validate Repository Structure
        run: |
          test -f frontend/index.html
          test -f docker/docker-compose.yml

  docker-build:
    runs-on: ubuntu-latest
    needs: validate

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Build Backend Container
        run: |
          docker build \
            -f docker/Dockerfile.backend \
            -t venom-backend .

      - name: Build Frontend Container
        run: |
          docker build \
            -f docker/Dockerfile.frontend \
            -t venom-frontend .

  deploy:
    runs-on: ubuntu-latest
    needs: docker-build

    steps:
      - name: Deploy VENOM Motherland
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.VENOM_HOST }}
          username: ${{ secrets.VENOM_USER }}
          key: ${{ secrets.VENOM_SSH_KEY }}
          script: |
            set -e

            cd ~/venom-motherland

            git pull origin main

            docker compose down

            docker compose up -d --build

            docker ps

            echo "===================================="
            echo "VENOM MOTHERLAND DEPLOYMENT SUCCESS"
            echo "===================================="
            
